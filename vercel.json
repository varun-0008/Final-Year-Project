{
  "version": 2,
  "functions": {
    "api/index.js": {
      "memory": 1024,
      "maxDuration": 15,
      "includeFiles": "backend/database/**,backend/scripts/**,student-app-debug.apk,admin-web/**"
    }
  },
  "redirects": [
    {
      "source": "/download/apk",
      "destination": "https://github.com/varun-0008/Final-Year-Project/releases/download/v1.0.0/student-app-debug.apk",
      "permanent": false
    },
    {
      "source": "/student-app-debug.apk",
      "destination": "https://github.com/varun-0008/Final-Year-Project/releases/download/v1.0.0/student-app-debug.apk",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/portal",
      "destination": "/admin-web/portal.html"
    },
    {
      "source": "/home",
      "destination": "/admin-web/portal.html"
    },
    {
      "source": "/gateway",
      "destination": "/admin-web/portal.html"
    },
    {
      "source": "/student",
      "destination": "/admin-web/student.html"
    },
    {
      "source": "/student-portal",
      "destination": "/admin-web/student.html"
    },
    {
      "source": "/admin",
      "destination": "/admin-web/index.html"
    },
    {
      "source": "/librarian",
      "destination": "/admin-web/index.html"
    },
    {
      "source": "/dashboard",
      "destination": "/admin-web/index.html"
    },
    {
      "source": "/login",
      "destination": "/admin-web/login.html"
    },
    {
      "source": "/",
      "destination": "/admin-web/portal.html"
    },
    {
      "source": "/(.*)",
      "destination": "/admin-web/$1"
    }
  ]
}
